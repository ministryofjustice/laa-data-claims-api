# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
#
ignore:
  # Additional recent glibc libc6 CVEs reported by Snyk (introduced via the
  # Ubuntu 24.04-based build/scanner image). These are transitive OS-package
  # vulnerabilities (glibc/libc6) that are fixed upstream in 2.39-0ubuntu8.9 and
  # will be resolved when the shared build image is rebuilt or the base-image is
  # updated (docker build --pull). No application-code remediation is available
  # from this repo; time-boxed so CI/maintainers will re-evaluate once the base
  # image propagates the fix.
  SNYK-UBUNTU2404-GLIBC-18741477:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-6368 introduced via the
          shared build/scanner image. Fixed upstream in 2.39-0ubuntu8.9; will be
          resolved by rebuilding on the updated base image. Not fixable from
          application code.
        expires: 2026-10-25T00:00:00.000Z
  SNYK-UBUNTU2404-GLIBC-18741516:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-6791 introduced via the
          shared build/scanner image. Fixed upstream in 2.39-0ubuntu8.9; will be
          resolved by rebuilding on the updated base image. Not fixable from
          application code.
        expires: 2026-10-25T00:00:00.000Z
  SNYK-UBUNTU2404-GLIBC-19383476:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-19499 introduced via the
          shared build/scanner image. Fixed upstream in 2.39-0ubuntu8.9; will be
          resolved by rebuilding on the updated base image. Not fixable from
          application code.
        expires: 2026-10-25T00:00:00.000Z
  SNYK-UBUNTU2404-GLIBC-19383517:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-19542 introduced via the
          shared build/scanner image. Fixed upstream in 2.39-0ubuntu8.9; will be
          resolved by rebuilding on the updated base image. Not fixable from
          application code.
        expires: 2026-10-25T00:00:00.000Z
  SNYK-UBUNTU2404-GLIBC-19383885:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-77117 introduced via the
          shared build/scanner image. Fixed upstream in 2.39-0ubuntu8.9; will be
          resolved by rebuilding on the updated base image. Not fixable from
          application code.
        expires: 2026-10-25T00:00:00.000Z
  SNYK-UBUNTU2404-GLIBC-19437583:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-18374 introduced via the
          shared build/scanner image. Fixed upstream in 2.39-0ubuntu8.9; will be
          resolved by rebuilding on the updated base image. Not fixable from
          application code.
        expires: 2026-10-25T00:00:00.000Z
  SNYK-UBUNTU2404-GLIBC-19437849:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-80489 introduced via the
          shared build/scanner image. Fixed upstream in 2.39-0ubuntu8.9; will be
          resolved by rebuilding on the updated base image. Not fixable from
          application code.
        expires: 2026-10-25T00:00:00.000Z

  SNYK-UBUNTU2404-GLIBC-19785393:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) glibc CVE-2026-89092 introduced via the
          shared build/scanner image (glibc/libc6, base-files, gcc-14/libstdc++6,
          zlib/zlib1g, ca-certificates). Transitive OS-package vulnerability, not a
          dependency declared by this repo. The application runtime image is
          amazoncorretto:*-alpine (musl, no glibc); glibc/libc6 only appears in the
          Ubuntu-based build stage / scanner image. Will be resolved automatically
          once Canonical publishes a fixed libc6 package and the base image is
          rebuilt (docker build --pull). No application-code remediation is
          available from this repo. Time-boxed so CI/maintainers will re-evaluate
          once the fix has propagated.
        expires: 2026-11-06T00:00:00.000Z

  # CVE-2026-85091 - zlib/zlib1g (Ubuntu 24.04 base-image OS package).
  # Heap buffer overflow in gz_vacate(). No fixed version available upstream for
  # Ubuntu 24.04 at the time of this ignore. Same pattern as the glibc/openssl entries
  # above — introduced via the shared ecr-publish-image build image, not this repo's
  # own Dockerfiles. Time-boxed so CI revisits once Canonical publishes a fix.
  SNYK-UBUNTU2404-ZLIB-19530295:
    - '*':
        reason: >-
          Base-image (Ubuntu 24.04) zlib/zlib1g CVE-2026-85091 introduced via the
          shared ecr-publish-image reusable workflow's build image. No fixed version
          available upstream for Ubuntu 24.04. Not fixable from application code.
        expires: 2026-10-14T00:00:00.000Z

# Example entry format:
#  SNYK-VULNERABILITY-ID:
#    - '<package>@<version>':
#        reason: <reason for ignoring>
#        expires: YYYY-MM-DDTHH:MI:SS.000Z
#        created: YYYY-MM-DDTHH:MI:SS.000Z
patch: {}