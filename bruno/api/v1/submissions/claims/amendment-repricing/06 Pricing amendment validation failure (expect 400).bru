meta {
  name: 06 Pricing amendment validation failure (expect 400)
  type: http
  seq: 6
}

patch {
  url: http://{{HOST}}/api/v1/submissions/:submission_id/claims/:claim_id
  body: json
  auth: inherit
}

params:path {
  claim_id: {{CLAIM_ID}}
  submission_id: {{SUBMISSION_ID}}
}

headers {
  Authorization: {{AUTH_TOKEN}}
}

script:pre-request {
  const axios = require('axios');
  const host = bru.getEnvVar('HOST');
  const auth = bru.getEnvVar('AUTH_TOKEN');
  const submissionId = bru.getEnvVar('SUBMISSION_ID');
  const claimId = bru.getEnvVar('CLAIM_ID');
  if (!host || !submissionId || !claimId) {
    throw new Error('HOST/SUBMISSION_ID/CLAIM_ID must be set in the environment.');
  }
  const url = `http://${host}/api/v1/submissions/${submissionId}/claims/${claimId}`;
  const resp = await axios.get(url, { headers: { Authorization: auth } });
  if (resp.status !== 200 || resp.data == null || resp.data.version == null) {
    throw new Error(`Pre-request failed: could not read claim version (status=${resp.status}).`);
  }
  bru.setEnvVar('AR_CLAIM_VERSION', String(resp.data.version));
}

body:json {
  {
    "version": {{AR_CLAIM_VERSION}},
    "net_profit_costs_amount": 9999.00,
    "amendment_user_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "amendment_requested_by": "PROVIDER",
    "amendment_reason_code": "CASE_REOPENED_REBILLED"
  }
}

tests {
  if (bru.getEnvVar("AR_STUBBED_FSP") !== "true") {
    // Non-stubbed environment: this scenario cannot deterministically produce an FSP validation failure.
    // Set AR_STUBBED_FSP=true in the environment to opt-in to strict assertions.
    return;
  }

  if (res.status !== 400) {
    throw new Error("Expected 400 for FSP validation failure scenario. Run this against a stubbed FSP validation-failure environment.");
  }

  const body = res.getBody();
  const text = JSON.stringify(body);
  if (!text.includes("INVALID_FSP_VALIDATION_FAILURE")) {
    throw new Error("Expected INVALID_FSP_VALIDATION_FAILURE in response body");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}





