meta {
  name: 05 Verify pricing creates new fee snapshot
  type: http
  seq: 5
}

get {
  url: http://{{HOST}}/api/v1/submissions/:submission_id/claims/:claim_id
  body: none
  auth: inherit
}

params:path {
  claim_id: {{CLAIM_ID}}
  submission_id: {{SUBMISSION_ID}}
}

headers {
  Authorization: {{AUTH_TOKEN}}
}

tests {
  if (res.status !== 200) {
    throw new Error("Expected 200 from post-pricing claim read");
  }

  const baselineCfdId = bru.getEnvVar("AR_BASELINE_CFD_ID");
  if (!baselineCfdId) {
    throw new Error("AR_BASELINE_CFD_ID missing. Run '01 Capture baseline claim' first.");
  }

  const body = res.getBody();
  const fee = body.fee_calculation_response || {};
  const postCfdId = String(fee.calculated_fee_detail_id ?? "");
  const postTotal = String(fee.total_amount ?? "");

  bru.setEnvVar("AR_POST_PRICING_CFD_ID", postCfdId);
  bru.setEnvVar("AR_POST_PRICING_TOTAL_AMOUNT", postTotal);

  if (!postCfdId) {
    throw new Error("Post-pricing claim has no calculated_fee_detail_id");
  }

  if (postCfdId === baselineCfdId) {
    throw new Error("Expected pricing amendment to create a new calculated fee snapshot");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

