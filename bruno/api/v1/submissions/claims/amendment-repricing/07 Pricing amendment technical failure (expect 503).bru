meta {
  name: 07 Pricing amendment technical failure (expect 503)
  type: http
  seq: 7
}

patch {
  url: http://{{HOST}}/api/v1/submissions/:submission_id/claims/:claim_id
  body: json
  auth: inherit
}

params:path {
  claim_id: {{CLAIM_ID}}
  submission_id: {{SUBMISSION_ID}}
}

headers {
  Authorization: {{AUTH_TOKEN}}
}

body:json {
  {
    "fee_code": "FEE-TIMEOUT",
    "amendment_user_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "amendment_requested_by": "PROVIDER",
    "amendment_reason_code": "CASE_REOPENED_REBILLED"
  }
}

tests {
  if (res.status !== 503) {
    throw new Error("Expected 503 for FSP technical/timeout failure scenario. Run this against a stubbed technical-failure environment.");
  }

  const body = res.getBody();
  const text = JSON.stringify(body);
  if (!text.includes("TECHNICAL_ERROR_FSP_REPRICING_FAILURE")) {
    throw new Error("Expected TECHNICAL_ERROR_FSP_REPRICING_FAILURE in response body");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

