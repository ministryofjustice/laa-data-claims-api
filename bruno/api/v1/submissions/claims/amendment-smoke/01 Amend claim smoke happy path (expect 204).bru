meta {
  name: 01 Amend claim smoke happy path (expect 204)
  type: http
  seq: 1
}

patch {
  url: http://{{HOST}}/api/v1/submissions/:submission_id/claims/:claim_id
  body: json
  auth: inherit
}

params:path {
  claim_id: {{CLAIM_ID}}
  submission_id: {{SUBMISSION_ID}}
}

headers {
  Authorization: {{AUTH_TOKEN}}
}

body:json {
  {
    "client_forename": "AmendSmoke",
    "client_surname": "HappyPath",
    "amendment_user_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
    "amendment_requested_by": "PROVIDER",
    "amendment_reason_code": "CASE_REOPENED_REBILLED"
  }
}

tests {
  if (res.status !== 204) {
    throw new Error("Expected 204 for amendment smoke PATCH request");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
