meta {
  name: 02 Verify amended claim fields (expect 200)
  type: http
  seq: 2
}

get {
  url: http://{{HOST}}/api/v1/submissions/:submission_id/claims/:claim_id
  body: none
  auth: inherit
}

params:path {
  claim_id: {{CLAIM_ID}}
  submission_id: {{SUBMISSION_ID}}
}

headers {
  Authorization: {{AUTH_TOKEN}}
}

tests {
  if (res.status !== 200) {
    throw new Error("Expected 200 from amended claim read");
  }
  
  const body = res.getBody();
  
  if (body.client_forename !== "AmendSmoke") {
    throw new Error("Expected client_forename to match amendment smoke value");
  }
  
  if (body.client_surname !== "HappyPath") {
    throw new Error("Expected client_surname to match amendment smoke value");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
